NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Preferred current key name. The value may be a Supabase publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy variable name remains accepted.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Server-only Supabase secret key (recommended; never prefix with NEXT_PUBLIC_).
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Optional legacy fallback if your project has not created a secret key.
SUPABASE_SERVICE_ROLE_KEY=
# Protect scheduled job endpoints with a long random secret.
CRON_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
# Optional separate salt for one-way IP hashes stored by the rate limiter.
RATE_LIMIT_SALT=REPLACE_WITH_ANOTHER_RANDOM_SECRET
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NEXT_PUBLIC_APP_URL=http://localhost:3000
