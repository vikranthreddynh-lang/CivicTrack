# Optional: restrict this browser key by HTTP referrer and enable Maps JavaScript API.
# With no key or a map load failure, JANSETU uses its OpenStreetMap preview.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional: server-side Gemini complaint suggestions. Never use NEXT_PUBLIC_ here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: Cloudflare Workers AI Whisper transcription (demo works without it).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
