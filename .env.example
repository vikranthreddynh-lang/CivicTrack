# Optional: restrict this browser key by HTTP referrer and enable Maps JavaScript API.
# With no key or a map load failure, JANSETU uses its OpenStreetMap preview.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Required for public resident/admin login and shared production data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy project anon key is also accepted if the publishable key is not available.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required only for admin invitations and secure invitation acceptance. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: server-side Gemini complaint suggestions. Never use NEXT_PUBLIC_ here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: Cloudflare Workers AI Whisper transcription (demo works without it).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
